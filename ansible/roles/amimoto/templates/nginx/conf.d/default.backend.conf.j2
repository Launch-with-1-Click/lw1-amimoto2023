server {
    {% if server_name == amimoto_ec2_instance_id %}
    listen      {{ listen_backend }} default;
    server_name _;
    {% else %}
    listen      {{ listen_backend }};
    server_name {{ server_name }}{% if cf_domain is defined and cf_domain %} {{ cf_domain }}{% endif %};
    {% endif %}
    root        {{ document_root }};
    index       index.php index.html index.htm;

    access_log  /var/log/nginx/{{ server_name }}.backend.access.log backend;

    keepalive_timeout 25;
    port_in_redirect  off;

    gzip              off;
    gzip_vary         off;

    {% if wp_multisite %}
    #include /etc/nginx/wp-singlesite;
    include /etc/nginx/wp-multisite-subdir;
    {% else %}
    include /etc/nginx/wp-singlesite;
    #include /etc/nginx/wp-multisite-subdir;
    {% endif %}

    location = /ping.txt {
        default_type text/plain;
        return 200 "ok\n";
    }
}
