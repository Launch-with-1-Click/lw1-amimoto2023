server {
    {% if server_name == amimoto_ec2_instance_id %}
    listen      {{ listen }} default;
    server_name _;
    {% else %}
    listen      {{ listen }};
    server_name {{ server_name }}{% if cf_domain is defined and cf_domain %} {{ cf_domain }}{% endif %};
    {% endif %}
    root        {{ document_root }};
    index       index.html index.htm;
    charset     utf-8;

    access_log  /var/log/nginx/{{ server_name }}.access.log  main;
    error_log   /var/log/nginx/{{ server_name }}.error.log;

    include     /etc/nginx/drop;

    add_header X-Cache-Status $upstream_cache_status;
    expires $expires;

    set $mobile '';
    {% if mobile_detect_enable %}
    include /etc/nginx/mobile-detect;
    {% else %}
    #include /etc/nginx/mobile-detect;
    {% endif %}

    include     /etc/nginx/wp-front;
    #location / { return 301 https://{{ server_name }}$request_uri; }

    {% if server_name == amimoto_ec2_instance_id %}
    {% if phpmyadmin_enable %}
    # phpMyAdmin
    include     /etc/nginx/phpmyadmin;
    {% else %}
    #
    # When you use phpMyAdmin, uncomment the line "include /etc/nginx/phpmyadmin;"
    # and delete or comment out the below line "location ~* /(phpmyadmin|myadmin|pma) { }".
    #
    #include     /etc/nginx/phpmyadmin;
    location ~* /(phpmyadmin|myadmin|pma) { access_log off; return 404; }
    {% endif %}
    {% else %}
    location ~* /(phpmyadmin|myadmin|pma) { access_log off; return 404; }
    {% endif %}

    #
    # redirect server error pages to the static page /50x.html
    #
    error_page  502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }

    location = /ping.txt {
        default_type text/plain;
        return 200 "ok\n";
    }
}
