; OPcache configuration managed by Ansible
{% if amimoto_php_version is version('8.5', '<') %}
zend_extension=opcache
{% endif %}
opcache.enable={{ amimoto_php_opcache_enable }}
opcache.memory_consumption={{ amimoto_php_opcache_memory_consumption }}
opcache.interned_strings_buffer={{ amimoto_php_opcache_interned_strings_buffer }}
opcache.max_accelerated_files={{ amimoto_php_opcache_max_accelerated_files }}
opcache.revalidate_freq={{ amimoto_php_opcache_revalidate_freq }}
opcache.validate_timestamps={{ amimoto_php_opcache_validate_timestamps }}
